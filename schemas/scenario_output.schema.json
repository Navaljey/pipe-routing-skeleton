{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pipe-routing-skeleton/scenario_output.schema.json",
  "title": "S0 출력 (CLAUDE.md §7.2 확장, D49)",
  "type": "object",
  "required": ["routes", "global"],
  "properties": {
    "scenario": {"type": "string"},
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["pipe_id", "success", "waypoints", "fittings", "supports", "layer0", "J", "fail_causes"],
        "properties": {
          "pipe_id": {"type": "string"},
          "type_id": {"type": "string"},
          "nominal_size": {"type": "string"},
          "success": {"type": "boolean"},
          "waypoints": {"type": "array", "items": {"$ref": "#/$defs/vec3"}},
          "fittings": {
            "type": "array",
            "items": {
              "type": "object", "required": ["type", "pos"],
              "properties": {"type": {"enum": ["elbow_90", "elbow_45", "tee", "gate_valve"]}, "pos": {"$ref": "#/$defs/vec3"}}
            }
          },
          "supports": {
            "type": "array",
            "items": {
              "type": "object", "required": ["pos", "face", "angle_length_mm", "kg"],
              "properties": {
                "pos": {"$ref": "#/$defs/vec3"},
                "face": {"enum": ["floor", "ceiling", "wall_x0", "wall_x1", "wall_y0", "wall_y1"]},
                "angle_length_mm": {"type": "number", "minimum": 0},
                "kg": {"type": "number", "minimum": 0},
                "form": {"enum": ["A", "B", "C", "D"], "description": "D80 서포트 형식"},
                "variant": {"enum": ["standard", "reinforced"]},
                "section": {"type": "string"},
                "carried": {"type": "array", "items": {"type": "string"}},
                "kg_total": {"type": "number", "minimum": 0},
                "kg_share": {"type": "number", "minimum": 0},
                "members": {"type": "array", "items": {"type": "object", "required": ["a", "b", "role"],
                  "properties": {"a": {"$ref": "#/$defs/vec3"}, "b": {"$ref": "#/$defs/vec3"}, "role": {"type": "string"}}}},
                "origin": {"enum": ["D89"], "description": "D89: A·B·C 불가 위치에서 나란한 배관을 함께 얹은 D"},
                "attached": {"type": "boolean", "description": "D89 D 의 함께 얹힌 배관 쪽 사본 (부재 없음, kg = D81 몫)"},
                "shares": {"type": "object", "additionalProperties": {"type": "number"}},
                "s_mm": {"type": "number", "description": "배관 중심선 호 위치 (D82 보완 간격 재확인)"}
              }
            }
          },
          "layer0": {
            "type": "object",
            "description": "모듈 → true(통과) / false(위반) / null(해당 없음). 경로가 없으면 빈 객체",
            "propertyNames": {"enum": ["collision", "boundary", "bend", "gravity_slope", "valve", "branch", "support", "crossing"]},
            "additionalProperties": {"type": ["boolean", "null"]}
          },
          "J": {
            "oneOf": [
              {"type": "null"},
              {
                "type": "object",
                "required": ["total", "pipe", "elbow", "tee", "valve", "support"],
                "properties": {
                  "total": {"type": "number"}, "pipe": {"type": "number"}, "elbow": {"type": "number"},
                  "tee": {"type": "number"}, "valve": {"type": "number"}, "support": {"type": "number"}
                }
              }
            ]
          },
          "fail_causes": {"type": "array", "items": {"type": "string"}},
          "violations": {"type": "array"},
          "metrics": {"type": "object"},
          "router": {"type": "object"}
        }
      }
    },
    "global": {
      "type": "object",
      "required": ["total_pipes", "success_count", "J_total", "computation_time_sec"],
      "properties": {
        "total_pipes": {"type": "integer"},
        "routed_count": {"type": "integer"},
        "success_count": {"type": "integer"},
        "success_rate": {"type": ["number", "null"]},
        "success_rate_routed": {"type": ["number", "null"]},
        "J_total": {"type": "number"},
        "J_breakdown_success": {"type": "object"},
        "J_total_routed": {"type": "number"},
        "fail_causes": {"type": "object"},
        "pairwise_violation": {"type": "integer"},
        "computation_time_sec": {"type": "number"},
        "support_attribution": {"type": "string", "description": "D81 공유 서포트 J 귀속 규칙 이름"},
        "support_total_kg": {"type": "number", "minimum": 0, "description": "D81 서포트 실물 총무게 (묶음 1회, 경로 배관 전체)"},
        "shared_support_count": {"type": "integer", "minimum": 0},
        "shared_support_kg": {"type": "number", "minimum": 0},
        "full_success": {"type": "boolean", "description": "D77 ①: 규칙상 가능한(D64) 배관이 모두 Layer 0 통과"},
        "required_pipes": {"type": "integer", "minimum": 0, "description": "D77 ① 분모: D64 규칙상 불가능 배관만 뺀 배관 수"},
        "required_passed": {"type": "integer", "minimum": 0},
        "excluded_infeasible": {"type": "array", "items": {"type": "string"}, "description": "D77: 분모에서 뺀 D64 규칙상 불가능 배관 id"}
      }
    }
  },
  "$defs": {
    "vec3": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3}
  }
}
