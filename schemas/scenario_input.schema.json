{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pipe-routing-skeleton/scenario_input.schema.json",
  "title": "S0 시나리오 입력 (CLAUDE.md §7.1)",
  "type": "object",
  "required": ["block", "obstacles", "pipes"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "description": "선택. 시나리오 이름·생성기 설정 등 기록용. 라우터·검증기는 읽지 않는다",
      "properties": {
        "name": {"type": "string"},
        "source": {"enum": ["manual", "procedural"]}
      }
    },
    "block": {
      "type": "object",
      "required": ["width", "length", "height", "unit"],
      "additionalProperties": false,
      "properties": {
        "width": {"$ref": "#/$defs/positive_mm"},
        "length": {"$ref": "#/$defs/positive_mm"},
        "height": {"$ref": "#/$defs/positive_mm"},
        "unit": {"const": "mm"}
      }
    },
    "block_pair": {
      "type": "object",
      "description": "선택 (D76 ①, D93). 블록 2개를 x 방향으로 이은 합친 맵 — 공유 격벽 = 중심 x = shared_x, 두께 wall_thickness (x 범위 [shared_x − t/2, shared_x + t/2]) 인 supportable·penetrable 박스, 관통은 관통 배관의 crossing_window 로만",
      "required": ["shared_x"],
      "additionalProperties": false,
      "properties": {
        "shared_x": {"$ref": "#/$defs/positive_mm"},
        "wall_thickness": {"type": "number", "minimum": 0, "description": "공유 격벽 두께 mm (D93, 없으면 0). 양쪽 면이 10mm 격자 위"}
      }
    },
    "obstacles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "min", "max"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "type": {"type": "string"},
          "min": {"$ref": "#/$defs/vec3"},
          "max": {"$ref": "#/$defs/vec3"},
          "supportable": {"type": "boolean", "description": "D93: 면을 서포트 지지면으로 쓸 수 있음 (기본 false = D21). S1-7: true 는 미지원 오류 (S2 예정, M27)"},
          "penetrable": {"type": "boolean", "description": "D93: 배관 관통 가능 (기본 false). S1-7: true 는 미지원 오류 (S2 예정, M27)"},
          "penetration_axis": {"enum": ["x", "y", "z"], "description": "D93: 관통 축 (선택, 없으면 박스의 가장 짧은 변 축 — 추정)"}
        }
      }
    },
    "pipes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type_id", "nominal_size", "gravity_pipe", "min_slope",
                     "insulation_thickness", "start", "end"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "type_id": {"enum": ["T1", "T2", "T3", "T4", "T5", "T6", "T7", "T8"]},
          "nominal_size": {"enum": ["15A", "25A", "50A", "65A", "100A", "150A", "200A", "300A", "400A", "500A"]},
          "gravity_pipe": {"type": "boolean"},
          "min_slope": {"oneOf": [{"type": "null"}, {"type": "number", "exclusiveMinimum": 0, "maximum": 1}]},
          "insulation_thickness": {"type": "number", "minimum": 0},
          "start": {"$ref": "#/$defs/terminal"},
          "end": {"$ref": "#/$defs/terminal"},
          "valve_positions": {"type": "array", "items": {"$ref": "#/$defs/vec3"},
                              "description": "D111 이전 필드 (상위 호환으로만 남김, required 아님). 빈 배열만 허용 — 값이 있으면 로드 오류 (S2 §7 Q8). 밸브는 valves"},
          "branch_points": {"type": "array", "items": {"$ref": "#/$defs/vec3"},
                            "description": "D112 이전 필드 (상위 호환으로만 남김, required 아님). 빈 배열만 허용 — 값이 있으면 로드 오류 (S2 §7 Q8). 분기는 branches"},
          "valves": {
            "type": "array", "maxItems": 1,
            "description": "D111: 필요 밸브 — 위치는 라우터가 고른다. S2 = 게이트밸브 0 또는 1개, 주관에만 (§7 Q14)",
            "items": {"type": "object", "required": ["type"], "additionalProperties": false,
                      "properties": {"type": {"enum": ["gate"]}}}
          },
          "branches": {
            "type": "array", "minItems": 1, "maxItems": 5,
            "description": "D112: 분기 단자 1~5개 — 티 위치는 라우터가 고른다. 다리 구경 ≤ 주관 구경 (로더 오류)",
            "items": {
              "type": "object", "required": ["id", "nominal_size", "pos", "kind", "dir"], "additionalProperties": false,
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "nominal_size": {"enum": ["15A", "25A", "50A", "65A", "100A", "150A", "200A", "300A", "400A", "500A"]},
                "pos": {"$ref": "#/$defs/vec3"},
                "kind": {"enum": ["nozzle", "boundary"]},
                "dir": {"type": "array", "items": {"type": "integer", "minimum": -1, "maximum": 1}, "minItems": 3, "maxItems": 3},
                "host": {"type": "string", "description": "선택. 노즐이 붙은 장애물 id (D28)"},
                "flow": {"enum": ["out", "in"], "description": "§7 Q1: out = 갈래 (주관 → 티 → 다리 단자, dir = 도착 방향), in = 합류 (다리 단자 → 티 → 주관, dir = 출발 방향). 기본 out, 중력관 (T7·T8) 은 in 만"}
              }
            }
          },
          "crossing_window": {
            "type": "object",
            "description": "관통 배관만 (D76 ②). 공유 격벽 위 창 사각형 — 관통점은 이 안에서 라우터가 고른다",
            "required": ["y", "z"],
            "additionalProperties": false,
            "properties": {
              "y": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
              "z": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "positive_mm": {"type": "number", "exclusiveMinimum": 0},
    "vec3": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
    "terminal": {
      "type": "object",
      "required": ["pos", "kind", "dir"],
      "additionalProperties": false,
      "properties": {
        "pos": {"$ref": "#/$defs/vec3"},
        "kind": {"enum": ["nozzle", "boundary"]},
        "dir": {"type": "array", "items": {"type": "integer", "minimum": -1, "maximum": 1}, "minItems": 3, "maxItems": 3},
        "host": {"type": "string", "description": "선택. 노즐이 붙은 장애물 id (D28)"}
      }
    }
  }
}
